# Server-side only — next.config.js rewrites /api/v1/* → backend
# NOT NEXT_PUBLIC_ so HTTP calls from the browser stay same-origin through Next rewrites
API_URL=https://su-production-4561.up.railway.app

# Public browser URL — keep only for features that must connect directly, such as WebSocket
NEXT_PUBLIC_API_URL=https://su-production-4561.up.railway.app
