# Server-side only — next.config.js rewrites /api/v1/* → backend
# NOT NEXT_PUBLIC_ so the browser never calls the backend cross-origin
# Set to your production backend URL (e.g., https://seu-dominio.com.br or https://api.seu-dominio.com.br)
# Defaults to localhost:8000 if not specified (VPS deployment).
API_URL=${API_URL:-http://localhost:8000}
