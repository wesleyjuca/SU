# ─── AFJ CORE SYSTEM — Produção (HostGator VPS ou qualquer VPS com Docker) ───────
# Copiar para .env.prod, preencher valores, e rodar: docker compose -f docker-compose.prod.yml up -d

# ─── Aplicação ─────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME=AFJ CORE SYSTEM
VERSION=1.0.0
API_V1_STR=/api/v1

# ─── Banco de dados PostgreSQL (OBRIGATÓRIO) ──────────────────────────────────
# Formato: postgresql://user:password@host:port/database
# Se DATABASE_URL não informado, a aplicação iniciará em modo degradado (sem BD).
# No docker-compose.prod.yml, a conexão interna usa: postgresql+asyncpg://afj:PASSWORD@db:5432/afj_core
DATABASE_URL=postgresql://afj:POSTGRES_PASSWORD@localhost:5432/afj_core
POSTGRES_USER=afj
POSTGRES_PASSWORD=POSTGRES_PASSWORD
POSTGRES_DB=afj_core

# ─── Redis (OBRIGATÓRIO para produção) ─────────────────────────────────────────
# Sem Redis, tarefas Celery (agentes IA, OCR, alertas de prazo) não são consumidas.
# Formato: redis://:password@host:port
# No docker-compose.prod.yml, a conexão interna usa: redis://:REDIS_PASSWORD@redis:6379/0
REDIS_URL=redis://:REDIS_PASSWORD@localhost:6379/0
REDIS_PASSWORD=REDIS_PASSWORD
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ─── Qdrant (Vector Search para RAG/jurisprudência) ─────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ─── Segurança — OBRIGATÓRIO em produção ──────────────────────────────────────
# SECRET_KEY: chave de 48 caracteres para JWT. Reutilizar valor fixo em produção.
# Se não definido, gera efêmero a cada boot → todos os tokens são invalidados.
# Gerar: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ENCRYPTION_KEY: chave de cifra (32 caracteres). Reutilizar valor fixo em produção.
# Credenciais BYOK (Google Workspace) são cifradas com esta chave — perder torna-as indecifrável.
# Se não definido, derivado automaticamente de SECRET_KEY (não ideal para produção).
# Gerar: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS (lista JSON de origins permitidos) ──────────────────────────────────
# Se o frontend está em https://seu-dominio.com.br, adicione aqui.
# Formato: ["https://seu-dominio.com.br", "https://painel.seu-dominio.com.br"]
CORS_ORIGINS=["http://localhost:3000"]

# ─── Integrações externas ──────────────────────────────────────────────────────

# DataJud (CNJ) — chave PÚBLICA, compartilhada na doc do CNJ
# Para enriquecimento de processos (metadados + andamentos por número).
# O CNJ pode rotacionar; se parar de funcionar, o próprio CNJ documenta a nova chave.
CNJ_API_KEY=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==

# ─── IA — IMPORTANTE PARA AGENTES ─────────────────────────────────────────────
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
DEFAULT_CLAUDE_MODEL=claude-sonnet-5
DEFAULT_GEMINI_MODEL=gemini-2.5-flash
DEFAULT_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# ─── Google Workspace (OAuth) ──────────────────────────────────────────────────
# Deixar vazio para "não configurado" (usuários irão para o card de Integrações).
# Para integrar: criar credencial OAuth2 no Google Cloud, copiar valores abaixo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://seu-dominio.com.br/api/v1/integrations/google/callback

# ─── Polling de andamentos ────────────────────────────────────────────────────
PROCESS_POLLING_INTERVAL_MINUTES=30
PROCESS_POLLING_BATCH_SIZE=50
POLL_AI_SUMMARY=false
PUBLICATION_SCAN_HOUR=7
DEADLINE_ALERT_DAYS=[3,7,15]

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Para enviar notificações por email (convites, prazos, movimentações).
# Suporta qualquer SMTP; exemplo usa Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=afj-core@afjadvogados.com.br
SMTP_FROM_NAME=AFJ CORE SYSTEM
EMAIL_ENABLED=false

# ─── Sentry (monitoramento de erros, opcional) ─────────────────────────────────
# Se configurado, erros em produção são enviados para o painel Sentry.
SENTRY_DSN=

# ─── Web Push / VAPID (notificações push no navegador, opcional) ────────────────
# Gerar chaves: python -c "from py_vapid import Vapid; v = Vapid(); v.generate_keys(); print(v.private_key.decode(), v.public_key.decode())"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_EMAIL=mailto:dev@afjadvogados.com.br
PUSH_ENABLED=false

# ─── URL pública do sistema ───────────────────────────────────────────────────
# Usada nos redirects de pagamento (Stripe/Mercado Pago) e na notification_url
# dos webhooks. Ex.: https://sistema.seuescritorio.com.br
# Se vazio, usa o primeiro CORS origin.
PUBLIC_BASE_URL=

# ─── Domínio / TLS (Caddy reverse-proxy) ──────────────────────────────────────
# DOMAIN: o domínio público do sistema (ex.: sistema.afjadvogados.com.br).
# Deve apontar (registro A) para o IP do VPS, com portas 80/443 abertas —
# o Caddy emite e renova o certificado Let's Encrypt automaticamente.
# Com DOMAIN=localhost, usa certificado interno auto-assinado (teste local).
DOMAIN=localhost
# Email para avisos de expiração do Let's Encrypt
ACME_EMAIL=

# ─── Variáveis do docker-compose.prod.yml ─────────────────────────────────────
# (já preenchidas acima, repetidas aqui para referência)
POSTGRES_PASSWORD=POSTGRES_PASSWORD
REDIS_PASSWORD=REDIS_PASSWORD
